# =====================================================================
# Fatijardins — variáveis de ambiente
#
# Copie este ficheiro para .env.local e preencha os valores:
#   cp .env.example .env.local
# O .env.local NUNCA deve ser enviado para o Git (já está no .gitignore).
# Na Vercel, as mesmas variáveis definem-se em Settings → Environment Variables.
#
# As chaves encontram-se no painel do Supabase, em
# Project Settings → API Keys (e o URL em Project Settings → Data API).
# =====================================================================

# Endereço do projeto Supabase (ex.: https://abcdefghijklmnop.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (sb_publishable_…) ou, em projetos antigos, a chave "anon".
# Pode ser vista por qualquer pessoa: o acesso aos dados é protegido pela RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (sb_secret_…) ou, em projetos antigos, a "service_role".
# SÓ para o servidor: dá acesso total à base de dados. Nunca a partilhe nem
# lhe ponha o prefixo NEXT_PUBLIC_. É necessária para o gerente criar acessos
# à app para os colaboradores (sem ela, o resto da app funciona).
SUPABASE_SECRET_KEY=

# Endereço público da app, sem barra no fim (ex.: https://fatijardins.vercel.app).
# Usado nas ligações de recuperação de palavra-passe enviadas por email.
# Em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
