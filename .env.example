# Copia este ficheiro para ".env.local" (desenvolvimento) e preenche os
# valores reais. Em produção (Vercel), define as mesmas variáveis em
# Project Settings → Environment Variables — nunca commites o ".env"
# real nem cometas os valores preenchidos neste ficheiro.

# --- Supabase ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — ignora RLS. Só é usada no servidor (crons, ações
# admin). Nunca a exponhas com o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Crons / webhooks (ver pasta .github/workflows) -------------------
# Partilhado por todos os endpoints /api/cron/* — cada um valida este
# segredo a si mesmo. Gera uma string aleatória longa.
CRON_SECRET=
# URL pública da app em produção, usada pelos workflows do GitHub
# Actions para chamar os endpoints de cron (ex.: https://rc-gest-o.vercel.app).
APP_URL=
# Segredo do webhook de leads do Google Forms (/api/leads/google-forms,
# enviado como "Authorization: Bearer ...") e do webhook unificado de
# leads do site/Google Forms mais recente (/api/webhooks/leads, enviado
# como cabeçalho "x-api-key") — o mesmo segredo serve os dois.
LEADS_WEBHOOK_SECRET=

# --- Leads do Meta Ads (Facebook/Instagram) — /api/webhooks/facebook ---
# Token inventado por nós, usado só para a Meta confirmar que o webhook é
# nosso ao ligar a subscrição (campo "Verify Token" nas definições do
# webhook da App da Meta). Gera uma string aleatória, igual ao CRON_SECRET.
META_VERIFY_TOKEN=
# Token de acesso à Página de Facebook/Instagram, usado para ir buscar os
# dados completos de cada lead à Graph API (Meta for Developers → a tua
# App → Messenger/Leads → geração de token de acesso da Página).
META_PAGE_ACCESS_TOKEN=
# App Secret da App criada no Meta for Developers (Settings → Basic → App
# Secret) — usado para confirmar que cada pedido POST ao webhook veio
# mesmo da Meta (assinatura HMAC-SHA256), não de outra origem a imitar o
# endpoint. Sem isto definido, a verificação é só saltada com um aviso.
META_APP_SECRET=
# Estúdio a que se atribuem os leads do Meta Ads por omissão ("fatima" ou
# "leiria") — há uma só Página/conta de anúncios para o negócio todo, por
# isso é preciso dizer a quem pertencem estes leads.
META_LEADS_ESTUDIO_PADRAO=
# Opcional: se um dia houver um formulário de lead ads por estúdio dentro
# dessa mesma Página, mapeia cada form_id ao estúdio certo, sem precisar
# de outra Página nem de outro token. Formato JSON, ex.:
# META_FORM_ESTUDIO_MAP={"1234567890123456":"fatima","2345678901234567":"leiria"}
META_FORM_ESTUDIO_MAP=

# --- Google Calendar (presenças automáticas) ---------------------------
GOOGLE_CALENDAR_ID_FATIMA=
GOOGLE_CALENDAR_ID_LEIRIA=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- SMS Gate (lembretes de treino por SMS) ----------------------------
# App "SMS Gate" (sms-gate.app / android-sms-gateway) — CADA ESTÚDIO
# TEM O SEU PRÓPRIO TELEMÓVEL, por isso há um conjunto de 3 variáveis
# por estúdio (mesmo padrão de GOOGLE_CALENDAR_ID_FATIMA/_LEIRIA). URL
# base do servidor local da app, no telemóvel desse estúdio (ex.:
# http://192.168.1.50:8080 ou o endereço público que tiverem
# configurado para lá chegar) e as credenciais definidas nas
# definições do servidor local, dentro da própria app.
SMS_GATEWAY_URL_FATIMA=
SMS_GATEWAY_USERNAME_FATIMA=
SMS_GATEWAY_PASSWORD_FATIMA=
SMS_GATEWAY_URL_LEIRIA=
SMS_GATEWAY_USERNAME_LEIRIA=
SMS_GATEWAY_PASSWORD_LEIRIA=
# Se um telemóvel ficar offline, o alerta aparece dentro da própria app
# (faixa vermelha + Centro de alertas, só para esse estúdio) — não há
# nenhum envio de email.
